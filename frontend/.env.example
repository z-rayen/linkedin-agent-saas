# Copy to .env.local (never commit real values). Every value is a placeholder or a documented default.

# Where the browser sends API calls. "/api" goes through the dev proxy (or the production reverse proxy) to the backend.
VITE_API_BASE_URL=/api

# Development only: the Vite dev server port. Set FRONTEND_ORIGIN in backend/.env to http://localhost:<this port>.
VITE_DEV_PORT=5173

# Development only: the backend the dev proxy forwards /api to.
VITE_DEV_API_TARGET=http://127.0.0.1:8000
