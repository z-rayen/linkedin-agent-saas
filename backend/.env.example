# LOGIN_ADDRESS_FREE_FAILURES=20
# LOGIN_BASE_DELAY_SECONDS=2.0
# LOGIN_MAX_DELAY_SECONDS=900.0
# LOGIN_FORGET_SECONDS=3600.0
# TRUSTED_PROXIES=""
# ACCESS_TOKEN_EXPIRE_MINUTES=10080
# OAUTH_STATE_EXPIRE_MINUTES=10

# Profile defaults (used until the user saves a profile)
# DEFAULT_FIELD="Machine Learning, Data Science"
# DEFAULT_SKILLS="Python, TensorFlow, NLP, MLOps, AWS, SQL"
# DEFAULT_LEVEL="Student / Junior"
# DEFAULT_MIN_MATCH_SCORE=70
# DEFAULT_JOB_FEED_URL="https://weworkremotely.com/categories/remote-data-science-jobs.rss"
# DEFAULT_CERT_FEED_URL="https://aws.amazon.com/blogs/training-and-certification/feed/"

# Embeddings and private data
# Embedding model for the knowledge base (fastembed). Its files are downloaded once, into FASTEMBED_CACHE_DIR,
# on first use or at startup when EMBEDDING_WARM_ON_STARTUP is true. The first download needs network access and disk
# space; later starts reuse the cache. Changing the model changes the vector size: the knowledge base must be re-indexed.
# EMBEDDING_MODEL="sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2"
# PRIVATE_DATA_DIR="data/private"

