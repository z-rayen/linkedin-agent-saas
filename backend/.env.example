# Template for backend/.env (the API). Copy it, fill in the values, and never commit the real file.
# Docker Compose reads a separate ROOT .env (see .env.example at the repository root).

# --- Database ------------------------------------------------------------------------------
# Local development: the database published by docker compose on port 5432.
# Inside Docker, the api container overrides this value to reach the "db" service.
DATABASE_URL=postgresql://linkedin:<db-password>@localhost:5432/linkedin_agent

# --- Security (required) ---------------------------------------------------------------------
# JWT signing key, at least 16 characters.  python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=
# Encrypts OAuth tokens at rest. Generate once and keep it: losing it makes stored connections unreadable.
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
TOKEN_ENCRYPTION_KEY=

# --- Browser and logs ----------------------------------------------------------------------
# The one variable that names the frontend: CORS and the OAuth redirects both use it. Origin only, no path.
# Set it to the address your frontend is served on (the React/Vite dev server uses 5173 by default).
FRONTEND_ORIGIN=http://localhost:5500
LOG_LEVEL=INFO

# --- LLM provider (Groq by default; any OpenAI-compatible endpoint works, see README) ---------
GROQ_API_KEY=
GROQ_URL=https://api.groq.com/openai/v1/chat/completions
GROQ_MODEL=openai/gpt-oss-20b
# Shared token budget of this process (free tier is about 8000 tokens per minute). Per process, not per cluster.
LLM_TOKENS_PER_MINUTE=8000
# Output cap of each completion. Reasoning tokens count against it, so a reasoning model can use most of it before
# the answer starts. A call cut off at this cap is retried once with the cap multiplied (below), up to the ceiling.
LLM_MAX_OUTPUT_TOKENS=2048
# A cut-off answer is retried with the cap multiplied by this factor (must be above 1)...
LLM_OUTPUT_BUDGET_MULTIPLIER=2.0
# ...and never above this hard ceiling. Ceiling + the longest prompt must fit in LLM_TOKENS_PER_MINUTE.
LLM_OUTPUT_TOKEN_CEILING=4096
# Reasoning effort of the model: low, medium or high. Empty: not sent, the provider default applies.
LLM_REASONING_EFFORT=
# Per-step overrides as JSON, keyed by step name (cv_tailor, analyze_job, default...). Empty fields use the globals.
# Example: LLM_STEP_OVERRIDES={"cv_tailor":{"reasoning_effort":"low"}}
LLM_STEP_OVERRIDES={}
# --- Application preparation (LangGraph) ------------------------------------------------------
# Revisions of the CV and the email after a failed grounding check. Two at most: the check is never relaxed.
GRAPH_MAX_REVISIONS=2
# Facts quoted, one per sentence, in the application email. Between 1 and 6.
# EMAIL_MAX_FACTS=3
# A running preparation sends a heartbeat at every step and during every wait. Without one for this long it is
# "stalled" and is resumed or failed at startup. Must be longer than the slowest external call plus the heartbeat
# interval (the application refuses to start otherwise: 30 + 10 = 40 seconds with the defaults).
PREPARATION_STALE_SECONDS=300
# Longest silence between two heartbeats while a run waits (token budget, rate-limit Retry-After). Chunks waits.
HEARTBEAT_INTERVAL_SECONDS=10
# Where workflow checkpoints live: postgres (survives restarts, production) or memory (tests, throwaway runs only).
CHECKPOINT_BACKEND=postgres
# Connection pool size of the checkpointer. The pool is opened once at startup, not per run.
CHECKPOINT_POOL_MAX_SIZE=4
# Local embedding model (retrieval of the knowledge base). Downloaded once into FASTEMBED_CACHE_DIR, not the OS temp dir.
FASTEMBED_CACHE_DIR=data/models/fastembed
# Load the embedding model when the API starts, so the first request does not wait for the download.
EMBEDDING_WARM_ON_STARTUP=true
# Checkpointer connection (psycopg v3). Empty: DATABASE_URL with the +psycopg2 suffix removed. Never logged.
CHECKPOINT_DATABASE_URL=

# --- Web search -----------------------------------------------------------------------------
SERPER_API_KEY=

# --- LinkedIn and GitHub OAuth apps (register your own) ----------------------------------------
# LinkedIn: https://www.linkedin.com/developers/   GitHub: Settings > Developer settings > OAuth Apps
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
LINKEDIN_REDIRECT_URI=http://localhost:8000/oauth/linkedin/callback
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_REDIRECT_URI=http://localhost:8000/oauth/github/callback

# --- LaTeX compiler for tailored CVs ----------------------------------------------------------
# Full path to the Tectonic binary. Leave empty to use "tectonic" from PATH.
# The API refuses to start when it is missing (TECTONIC_REQUIRED=true). Set false only if you never need CV PDFs.
# The Docker image installs Tectonic itself; compose overrides this value to /usr/local/bin/tectonic.
TECTONIC_PATH=
TECTONIC_TIMEOUT_SECONDS=180
TECTONIC_REQUIRED=true

# --- Email sending ---------------------------------------------------------------------------
# Dry-run is ON by default: nothing is sent. Turning it off alone is refused by the application.
# Real sending needs MAIL_REDIRECT_TO (every message goes to a test address) or MAIL_ALLOW_REAL_RECIPIENTS=true.
MAIL_DRY_RUN=true
MAIL_REDIRECT_TO=
MAIL_ALLOW_REAL_RECIPIENTS=false
MAIL_TIMEZONE=Africa/Tunis
MAIL_DAILY_CAP=10
MAIL_MIN_DELAY_SECONDS=300
MAIL_COMPANY_COOLDOWN_DAYS=30
# A send stuck in "sending" longer than this is shown as needs_verification and is never retried automatically.
MAIL_SENDING_TIMEOUT_SECONDS=900
# Domains that identify a person, not an employer. JSON list; "name.*" matches any suffix (yahoo.*).
FREE_MAIL_DOMAINS=["gmail.com","outlook.com","hotmail.com","live.com","yahoo.*","icloud.com","proton.me","gmx.*"]

SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
# Use an app password if your provider offers one. Never commit the real value.
SMTP_PASSWORD=
SMTP_FROM_ADDRESS=
SMTP_USE_STARTTLS=true
SMTP_TIMEOUT_SECONDS=20

# --- Settings not listed above: the defaults are shown, uncomment a line to change it ----------------
